<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape>
            <solid android:color="?attr/roomsound_button_disabled" />
            <corners android:radius="8dp" />
            <stroke
                android:width="1dp"
                android:color="?attr/roomsound_button_disabled_stroke" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <solid android:color="?attr/roomsound_button_danger_pressed_top" />
            <corners android:radius="8dp" />
            <stroke
                android:width="1dp"
                android:color="?attr/roomsound_skin" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape>
            <solid android:color="?attr/roomsound_button_danger_top" />
            <corners android:radius="8dp" />
            <stroke
                android:width="2dp"
                android:color="?attr/roomsound_danger" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="?attr/roomsound_button_danger_top" />
            <corners android:radius="8dp" />
            <stroke
                android:width="1dp"
                android:color="?attr/roomsound_skin" />
        </shape>
    </item>
</selector>
