<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape>
            <solid android:color="@color/roomsound_inset" />
            <corners android:radius="12dp" />
            <stroke
                android:width="1dp"
                android:color="@color/roomsound_button_disabled_stroke" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape>
            <solid android:color="@color/roomsound_field_focused" />
            <corners android:radius="12dp" />
            <stroke
                android:width="2dp"
                android:color="@color/roomsound_field_focus_stroke" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/roomsound_field" />
            <corners android:radius="12dp" />
            <stroke
                android:width="1dp"
                android:color="@color/roomsound_field_stroke" />
        </shape>
    </item>
</selector>
