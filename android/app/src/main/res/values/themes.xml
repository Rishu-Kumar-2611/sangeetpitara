<resources>
    <style name="Theme.RoomSound" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@color/roomsound_background_bottom</item>
        <item name="android:colorAccent">@color/roomsound_brass</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/roomsound_background_bottom</item>
        <item name="android:navigationBarColor">@color/roomsound_background_bottom</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <style name="Theme.RoomSound.ControlRequest" parent="Theme.RoomSound">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/roomsound_background_bottom</item>
    </style>
</resources>
