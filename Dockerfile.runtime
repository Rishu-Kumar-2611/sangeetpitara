# Production-only image. The Android toolchain intentionally lives in the
# separate Dockerfile target and is never pulled into this build.
FROM node:22.14.0-bookworm-slim

WORKDIR /app

ENV NODE_ENV=production

COPY package.json package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force

# Copy only the Node/WebSocket runtime and browser assets. This keeps Android
# sources, Gradle caches, logs, and local artifacts out of the production image.
COPY --chown=node:node index.html about.html contact.html privacy.html terms.html google4e6792fe7b47be54.html robots.txt sitemap.xml styles.css app.js account-client.mjs ads.mjs capture-tracks.js guest-id.js media-relay.mjs relay-pcm.js relay-capture-worklet.js relay-playout-worklet.js notifications-sw.js manifest.webmanifest ./
COPY --chown=node:node branding/sangeetpitara/05-diya-eighth-note.svg ./branding/sangeetpitara/
COPY --chown=node:node server.mjs auth.mjs persistence.mjs migrate.mjs security.mjs moderation.mjs observability.mjs audit.mjs billing.mjs smoke.mjs ./
COPY --chown=node:node migrations ./migrations
COPY --chown=node:node checks ./checks

RUN npm run check

USER node

EXPOSE 4173

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD node --input-type=module --eval "const port = process.env.PORT || 4173; const response = await fetch('http://127.0.0.1:' + port + '/health'); if (!response.ok) process.exit(1); const body = await response.json(); if (body.ok !== true) process.exit(1);"

CMD ["npm", "start"]
