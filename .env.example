PORT=4173
HOST=0.0.0.0
# TURN is REQUIRED for internet / cross-NAT playback (phone on 4G vs laptop on WiFi).
# STUN alone (stun.l.google.com) only works on the same WiFi/LAN. For production use one of:
# - Self-hosted coturn: TURN_URLS=turn:turn.example.com:3478
# - Managed (Twilio/Metered/Cloudflare): TURN_URLS=turn:global.turn.twilio.com:3478?transport=udp
# If multiple URLs, comma-separate. Username/credential must match your TURN server.
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
ALLOWED_ORIGINS=
# Set to 1 when behind a reverse proxy (nginx/Cloudflare) that sets X-Forwarded-For
TRUST_PROXY=
