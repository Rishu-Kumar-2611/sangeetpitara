# Copy this file to .env for local use. .env is ignored by Git; keep real
# usernames, credentials, and other secrets only in .env or a secret manager.
PORT=4173
HOST=0.0.0.0
APP_VERSION=0.1.0
LOG_LEVEL=info
# Browser room create/join is anonymous. REQUIRE_AUTH is retained only for
# compatibility with older deployments and does not gate WebSocket room entry.
NODE_ENV=development
REQUIRE_AUTH=0
# Retained for compatibility with older deployment templates; room entry is
# anonymous regardless of this value.
ALLOW_ANONYMOUS=
ADMIN_EMAILS=
# TURN is optional and disabled by default. STUN-only direct peer connections
# are free and work when peers can reach each other. Enable TURN only when a
# relay is required for restrictive NATs; put provider values in ignored .env.
TURN_ENABLED=0
# Example URL shape: turn:turn.example.com:3478
# If multiple URLs are needed, comma-separate them. The username and credential
# must match the TURN server.
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
# Browser media defaults to the binary PCM16 WebSocket relay so cross-NAT
# phone-to-laptop playback does not depend on a direct WebRTC path. Set to 0
# only to opt back into the direct STUN/WebRTC path; relay bandwidth is billed
# to this RoomSound server at scale.
MEDIA_RELAY_ENABLED=1
ALLOWED_ORIGINS=
# Set to 1 when behind a reverse proxy (nginx/Cloudflare) that sets X-Forwarded-For
TRUST_PROXY=
# Anonymous room access is unlocked by the configured rewarded-access flow. The
# demo-local/offline provider is only a development stand-in; replace it with a
# reviewed ad provider before a monetized launch.
REWARDED_ACCESS_ENABLED=1
REWARDED_AD_PROVIDER=demo-local
REWARDED_AD_MODE=offline
REWARDED_AD_DURATION_SECONDS=30
REWARDED_ACCESS_DURATION_HOURS=6
# Leave DATABASE_URL empty for offline development and tests. When set, RoomSound
# runs the checked-in PostgreSQL migrations before accepting requests.
DATABASE_URL=
DATABASE_SSL=
DATABASE_SSL_REJECT_UNAUTHORIZED=
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=10000
# Session cookies are HttpOnly and SameSite=Lax. Set this to 1 when serving HTTPS.
SESSION_COOKIE_SECURE=
# Seven days by default; the server caps this at 30 days.
SESSION_TTL_MS=604800000
# Optional billing seam. Billing remains disabled unless the provider and both
# backend secrets are configured in the deployment secret store.
BILLING_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_CHECKOUT_SUCCESS_URL=http://localhost:4173/?billing=success
STRIPE_CHECKOUT_CANCEL_URL=http://localhost:4173/?billing=cancel
STRIPE_PORTAL_RETURN_URL=http://localhost:4173/
# Reserved cache seam; the current single-process media plane does not require it.
REDIS_URL=
