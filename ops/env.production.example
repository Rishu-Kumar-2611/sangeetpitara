# Sanitized production template. Put real values in the platform secret store;
# do not commit a filled copy of this file.
NODE_ENV=production
HOST=0.0.0.0
# Render and most managed platforms inject PORT. Set it only for a fixed VPS.
PORT=4173

# Use a PostgreSQL-compatible secret URL. Startup applies migrations before the
# listener opens; leave this unset only for a deliberately ephemeral instance.
DATABASE_URL=
DATABASE_SSL=1
DATABASE_SSL_REJECT_UNAUTHORIZED=1
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=10000

# The browser origin allowlist is comma-separated. Use the exact HTTPS origin.
ALLOWED_ORIGINS=https://roomsound.example
TRUST_PROXY=1
SESSION_COOKIE_SECURE=1
SESSION_TTL_MS=604800000

# TURN is required for clients behind restrictive NATs. Keep credentials in the
# secret manager, never in this tracked example.
TURN_URLS=turns:turn.example.invalid:443
TURN_USERNAME=
TURN_CREDENTIAL=

# Optional future adapter seam. Paid access remains disabled unless all
# provider secrets are supplied at runtime; no Stripe SDK is required here.
BILLING_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# Optional cache seam; the current single-process room state does not require
# Redis. Do not advertise horizontal scaling until room state is shared.
REDIS_URL=
