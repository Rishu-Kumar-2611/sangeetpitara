{
  "name": "roomsound-prototype",
  "version": "1.1.7",
  "private": true,
  "description": "RoomSound private real-time audio room prototype",
  "type": "module",
  "engines": {
    "node": ">=22.14.0 <23"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.mjs",
    "migrate": "node --env-file-if-exists=.env migrate.mjs",
    "check": "node checks/syntax.mjs",
    "test": "node --test && node checks/origin.mjs && node checks/payload.mjs && node checks/rtc.mjs",
    "smoke": "node smoke.mjs",
    "test:browser": "playwright test",
    "test:postgres": "node checks/postgres-integration.mjs",
    "build": "npm run check"
  },
  "dependencies": {
    "@neon/config": "^1.13.0",
    "@neon/env": "^2.1.0",
    "pg": "^8.16.3",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0"
  }
}
